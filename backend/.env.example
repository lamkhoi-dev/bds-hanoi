# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
TRUST_PROXY=false
ENABLE_SWAGGER=true
ENABLE_SCHEDULED_BACKUP=false

# Database
DATABASE_URL="postgresql://bds_user:bds_password@localhost:5433/bds_db?schema=public"

# Redis / Bull / Cache
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Security - replace before staging/production
JWT_SECRET=replace-with-64-char-random-hex
ENCRYPTION_KEY=replace-with-64-char-random-hex

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=replace-with-meilisearch-master-key

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# Seed
SEED_ADMIN_EMAIL=admin@bds.com
SEED_ADMIN_PASSWORD=change-this-password
NEXT_PUBLIC_GA_MEASUREMENT_ID=
