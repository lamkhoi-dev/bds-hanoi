{
  "name": "bds-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "typecheck": "npx tsc -p backend/tsconfig.json --noEmit --pretty false && npx tsc -p frontend/tsconfig.json --noEmit --pretty false",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm test --workspace=backend -- --runInBand",
    "docker:prod:config": "docker compose -f docker-compose.prod.yml config --quiet",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "mammoth": "^1.12.0"
  }
}
