{$SITE_DOMAIN} {
	handle /bds-uploads/* {
		reverse_proxy minio:9000
	}

	# Sitemap sinh ở backend nhưng giữ nguyên URL công khai /sitemap.xml, nên không
	# phải đăng ký lại trong Search Console.
	handle /sitemap.xml {
		rewrite * /api/v1/seo/sitemap-index.xml
		reverse_proxy backend:4000
	}

	handle /sitemaps/* {
		uri replace /sitemaps /api/v1/seo/sitemaps 1
		reverse_proxy backend:4000
	}

	handle /api/v1/* {
		reverse_proxy backend:4000
	}

	handle /api/* {
		uri replace /api /api/v1 1
		reverse_proxy backend:4000
	}

	# Catch all other routes to Frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}

# www trả 502 là một mục trong danh sách fix SEO. Chuyển hướng 301 về apex.
# Cần bản ghi DNS A cho www trỏ về cùng IP thì Caddy mới cấp được chứng chỉ.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
