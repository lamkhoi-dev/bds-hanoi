(payment_access_log) {
	# Nhật ký truy cập CHỈ cho đường thanh toán (webhook SePay) — khách báo 15-19/9 "quét QR
	# chuyển khoản được nhưng không cộng tiền" và backend không nhận được webhook nào: không có
	# nhật ký ở cổng vào (Caddy) thì không thể phân biệt "SePay không gọi tới" với "SePay gọi
	# tới nhưng bị chuyển hướng/từ chối trước khi vào ứng dụng". Các đường khác bỏ qua để
	# không nhân đôi khối lượng log. Xoá Authorization/Cookie khỏi log: token webhook là bí mật.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
	@not_payment not path /api/v1/payment/* /api/payment/*
	log_skip @not_payment
}

{$SITE_DOMAIN} {
	import payment_access_log

	handle /bds-uploads/* {
		reverse_proxy minio:9000
	}

	# Sitemap sinh ở backend nhưng giữ nguyên URL công khai /sitemap.xml, nên không
	# phải đăng ký lại trong Search Console.
	handle /sitemap.xml {
		rewrite * /api/v1/seo/sitemap-index.xml
		reverse_proxy backend:4000
	}

	handle /sitemaps/* {
		uri replace /sitemaps /api/v1/seo/sitemaps 1
		reverse_proxy backend:4000
	}

	handle /api/v1/* {
		reverse_proxy backend:4000
	}

	handle /api/* {
		uri replace /api /api/v1 1
		reverse_proxy backend:4000
	}

	# Catch all other routes to Frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}

# www trả 502 là một mục trong danh sách fix SEO. Chuyển hướng 301 về apex.
# Cần bản ghi DNS A cho www trỏ về cùng IP thì Caddy mới cấp được chứng chỉ.
www.{$SITE_DOMAIN} {
	import payment_access_log
	redir https://{$SITE_DOMAIN}{uri} permanent
}
