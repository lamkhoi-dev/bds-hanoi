# --- BẤT ĐỘNG SẢN - PRODUCTION ENVIRONMENT VARIABLES ---
# Hãy copy file này thành .env và điền các thông tin bảo mật trước khi chạy docker-compose

# 1. Domain Configuration
# Thay bằng domain thật của bạn (ví dụ: https://bds.com)
FRONTEND_URL=https://your-domain.com
# URL API public, thường là domain + /api
PUBLIC_API_URL=https://your-domain.com/api

# 2. Database Configuration
DB_USER=bds_prod_user
# Thay đổi password này thành một chuỗi ngẫu nhiên bảo mật!
DB_PASSWORD=your_secure_db_password
DB_NAME=bds_prod_db

# 3. Redis Configuration
# Thay đổi password này thành một chuỗi ngẫu nhiên bảo mật!
REDIS_PASSWORD=your_secure_redis_password

# 4. Security Keys
# Tạo key 64 ký tự hex ngẫu nhiên: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_for_jwt
ENCRYPTION_KEY=replace_with_64_char_random_hex_for_encryption

# 5. Meilisearch
# Tạo key bảo mật cho Meilisearch
MEILISEARCH_MASTER_KEY=replace_with_meilisearch_master_key

# 6. Analytics (Tùy chọn)
NEXT_PUBLIC_GA_ID=

# 7. System 
# Cấu hình số CPU để build Next.js (tùy thuộc vào VPS mạnh hay yếu)
NEXT_BUILD_CPUS=2
