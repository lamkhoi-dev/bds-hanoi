# --- BẤT ĐỘNG SẢN HÀ NỘI — BIẾN MÔI TRƯỜNG PRODUCTION ---
# Copy thành .env rồi điền trước khi chạy:
#   docker compose -f docker-compose.vps.yml up -d --build

# ============ 1. DOMAIN & THƯƠNG HIỆU ============
# Chỉ tên miền, KHÔNG có https:// và không có dấu / cuối.
# Caddy dùng biến này để cấp chứng chỉ; compose dựng mọi URL công khai từ nó.
SITE_DOMAIN=nhadathanoi.vn
SITE_NAME=Nhà Đất Hà Nội
PROVINCE_NAME=Hà Nội

# Tên thương hiệu tách 2 dòng cho logo header (vd "Nhà Đất" / "Hà Nội"). Để trống thì
# layout.tsx tự lùi về suy luận "tên kết thúc bằng tên tỉnh" (xem site-config.ts).
NEXT_PUBLIC_BRAND_LINE1=
NEXT_PUBLIC_BRAND_LINE2=
# Tên rút gọn cho PWA/manifest (app/manifest.ts). Để trống thì dùng nguyên SITE_NAME.
NEXT_PUBLIC_SITE_SHORT_NAME=
# Hotline/email/Facebook hiển thị ở header, footer, trang hỗ trợ. Để trống thì hotline
# lùi về '0868126826' (fallback cứng trong code), email/Facebook ẩn hẳn khối liên quan.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=

# Tỉnh/thành mà site phục vụ. Khu vực ngoài danh sách này bị lọc khỏi bộ lọc, menu
# và sitemap — đây là bản vá cho lỗi "xã tỉnh khác lọt vào bộ lọc" khách báo.
#
# Nhận NHIỀU giá trị ngăn cách bằng dấu phẩy. Site nhadatxunghe.vn phục vụ cả Nghệ An
# lẫn Hà Tĩnh, nên ở đó phải đặt:  PROVINCE_SLUG=nghe-an,ha-tinh
PROVINCE_SLUG=ha-noi

# staging  => robots.ts chặn Google index toàn site (Disallow: /)
# production => cho phép index
# ⚠️ Giữ "staging" cho tới khi đã nhập dữ liệu Hà Nội và chốt domain. Nếu bật index
# khi site còn chạy dữ liệu Nghệ An, Google sẽ coi đây là bản trùng nội dung của
# nhadatxunghe.vn và phạt CẢ HAI site.
APP_ENV=staging

# report  = lớp quyết định SEO chỉ áp noindex, chưa 404/301 (mặc định, an toàn)
# enforce = bật 404 cho URL rác và 301 cho URL không chuẩn
# Chỉ đổi sang enforce sau khi đã theo dõi log ở chế độ report.
SEO_MODE=report

# Bật RIÊNG nhóm phân trang, độc lập với SEO_MODE ở trên:
#   ?page=1                        -> 301 về URL không có tham số page
#   ?page=0 / -1 / abc / 01        -> 404 (trang không tồn tại)
#   ?page=<vượt tổng số trang>     -> 404
# Vì sao tách khỏi SEO_MODE: đặt SEO_MODE=enforce sẽ ĐỒNG THỜI dời dạng URL landing
# (/dat-nen -> /ban/dat-nen) — khoảng 4.000 URL đang có thứ hạng. Khách chỉ yêu cầu
# sửa phân trang, nên dùng cờ này để làm đúng phần đó mà không dời gì khác.
SEO_ENFORCE_PAGINATION=1

# classic = bố cục trang chủ Nghệ An đang chạy thật, khách đã duyệt (mặc định, an toàn).
# grouped = bố cục Hà Nội theo PHẦN II mục 25 (tab động khu vực + 5 tab "Bán" + tab Dự
# án). Site Hà Nội đặt "grouped", site Nghệ An KHÔNG đổi giá trị này.
SITE_LAYOUT=classic

# ============ 2. DATABASE ============
DB_USER=bds_prod_user
# Đặt chuỗi ngẫu nhiên đủ dài: openssl rand -base64 24
DB_PASSWORD=
DB_NAME=bds_prod_db
# Chạy `prisma migrate deploy` lúc khởi động backend.
# ⚠️ GHI vào CSDL thật. Chỉ đặt true cho ĐÚNG lần deploy có migration mới, sau đó
# trả về false. Bắt buộc sao lưu và diễn tập trên bản sao trước.
RUN_MIGRATIONS=false

# ============ 3. REDIS ============
REDIS_PASSWORD=
# false sẽ khiến cache rơi về in-memory và refresh token mất khi restart container.
REDIS_ENABLED=true

# ============ 4. KHOÁ BẢO MẬT ============
# Tạo: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# ============ 5. MEILISEARCH ============
MEILISEARCH_MASTER_KEY=

# ============ 6. MINIO (lưu ảnh) ============
# BẮT BUỘC đổi. Cổng 9000/9001 chỉ bind loopback, muốn vào console thì SSH tunnel:
#   ssh -L 9001:127.0.0.1:9001 user@server
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ============ 7. FIREBASE (đăng nhập OTP qua SĐT) ============
# Dán nguyên JSON service account, hoặc chuỗi base64 của nó. Để trống thì
# backend vẫn chạy nhưng chức năng OTP tắt.
FIREBASE_SERVICE_ACCOUNT=

# ============ 8. EMAIL ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# ============ 9. ĐĂNG NHẬP MẠNG XÃ HỘI ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Đăng nhập OTP qua SĐT (frontend) — 7 biến này để trống thì Firebase Auth ở trình
# duyệt khởi tạo với config giả "YOUR_API_KEY", OTP không hoạt động, DÙ backend đã có
# FIREBASE_SERVICE_ACCOUNT. Lấy từ Firebase Console > Project Settings > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ============ 10. ANALYTICS ============
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ============ 11. HỆ THỐNG ============
# Số CPU dùng để build Next.js. Máy yếu để 1-2.
NEXT_BUILD_CPUS=2
ENABLE_SWAGGER=false
ENABLE_SCHEDULED_BACKUP=true
