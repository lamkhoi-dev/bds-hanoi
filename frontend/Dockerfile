FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_UPLOAD_BASE_URL=
ARG NEXT_PUBLIC_GA_ID=
ARG INTERNAL_API_URL=http://backend:4000
ARG NEXT_BUILD_CPUS=1
# Thương hiệu và phạm vi tỉnh: bake lúc build vì NEXT_PUBLIC_* được nhúng vào bundle.
ARG NEXT_PUBLIC_SITE_NAME=Nhà Đất Hà Nội
ARG NEXT_PUBLIC_PROVINCE_NAME=Hà Nội
ARG NEXT_PUBLIC_PROVINCE_SLUG=ha-noi
ARG NEXT_PUBLIC_BRAND_LINE1=
ARG NEXT_PUBLIC_BRAND_LINE2=
ARG NEXT_PUBLIC_SITE_SHORT_NAME=
ARG NEXT_PUBLIC_SUPPORT_PHONE=
ARG NEXT_PUBLIC_SUPPORT_EMAIL=
ARG NEXT_PUBLIC_FACEBOOK_URL=
# Analytics/pixel bổ sung — thiếu ARG/ENV này thì frontend/src/app/layout.tsx đọc được
# NEXT_PUBLIC_META_PIXEL_ID nhưng giá trị luôn rỗng lúc build (đã kiểm tra: biến này
# CHƯA từng có trong Dockerfile/compose/.env.prod.example).
ARG NEXT_PUBLIC_META_PIXEL_ID=
# 7 biến Firebase (đăng nhập OTP qua SĐT ở frontend) — CHƯA từng có ở đây, nên dù đã
# cấp FIREBASE_SERVICE_ACCOUNT cho backend thì OTP vẫn không bật được (frontend luôn
# init Firebase với "YOUR_API_KEY" giả). Xem frontend/src/lib/firebase.ts.
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
ARG NEXT_PUBLIC_APP_ENV=production
# report = tính quyết định SEO và chỉ áp noindex; enforce = bật 404/301 thật.
ARG NEXT_PUBLIC_SEO_MODE=report
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_UPLOAD_BASE_URL=$NEXT_PUBLIC_UPLOAD_BASE_URL
ENV NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID
ENV INTERNAL_API_URL=$INTERNAL_API_URL
ENV NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME
ENV NEXT_PUBLIC_PROVINCE_NAME=$NEXT_PUBLIC_PROVINCE_NAME
ENV NEXT_PUBLIC_PROVINCE_SLUG=$NEXT_PUBLIC_PROVINCE_SLUG
ENV NEXT_PUBLIC_BRAND_LINE1=$NEXT_PUBLIC_BRAND_LINE1
ENV NEXT_PUBLIC_BRAND_LINE2=$NEXT_PUBLIC_BRAND_LINE2
ENV NEXT_PUBLIC_SITE_SHORT_NAME=$NEXT_PUBLIC_SITE_SHORT_NAME
ENV NEXT_PUBLIC_SUPPORT_PHONE=$NEXT_PUBLIC_SUPPORT_PHONE
ENV NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL
ENV NEXT_PUBLIC_FACEBOOK_URL=$NEXT_PUBLIC_FACEBOOK_URL
ENV NEXT_PUBLIC_META_PIXEL_ID=$NEXT_PUBLIC_META_PIXEL_ID
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=$NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_SEO_MODE=$NEXT_PUBLIC_SEO_MODE
ENV NEXT_BUILD_CPUS=$NEXT_BUILD_CPUS
ENV NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/next.config.mjs ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
